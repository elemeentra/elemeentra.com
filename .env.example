# =============================================================
# ELEMEENTRA — Environment Variables
# Copy this file to .env.local for local (XAMPP) development.
# On Hostinger, set the same keys in hPanel → Advanced → Environment Variables.
# =============================================================

# ---- Database (MySQL / MariaDB via XAMPP locally) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=elemeentra
DB_CONNECTION_LIMIT=10

# ---- Auth / JWT ----
# Generate a strong secret: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=elemeentra_session

# ---- Admin Panel Security ----
# The admin panel is NOT served at /admin publicly.
# Requests to /admin return 404. Only this secret path works.
# Generate: openssl rand -hex 8
ADMIN_PATH=elemeentra-cms-x7k2m9pq

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# ---- Email (Nodemailer — used from Phase 6 onward) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Elemeentra <hello@elemeentra.com>"
